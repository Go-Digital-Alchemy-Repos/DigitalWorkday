# Database Configuration
POSTGRES_USER=dasana
POSTGRES_PASSWORD=dasana
POSTGRES_DB=dasana

# Database URL
# For Docker: postgresql://dasana:dasana@db:5432/dasana (uses container hostname)
# For local: postgresql://dasana:dasana@localhost:5432/dasana
# For Railway: Use the DATABASE_URL provided by Railway PostgreSQL addon
DATABASE_URL=postgresql://dasana:dasana@localhost:5432/dasana

# Application
NODE_ENV=development
PORT=5000
SESSION_SECRET=development-secret-change-before-production-32-chars
# Public app URL used for OAuth redirects and email links.
# Production example: https://digitalworkday.ai
APP_PUBLIC_URL=http://localhost:5000

# Google sign-in (optional)
# Production redirect URI: https://digitalworkday.ai/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to default to ${APP_PUBLIC_URL}/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URL=
# Comma-separated domain allowlist for Google sign-in. Example: example.com
GOOGLE_ALLOWED_DOMAIN=

# Required before saving integration secrets in production.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Cloudflare R2 (optional - for file uploads)
# CF_R2_ACCOUNT_ID=
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_BUCKET_NAME=
# CF_R2_PUBLIC_URL=
